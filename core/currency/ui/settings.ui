 <class>CurrencySettings</class>
 <widget class="QWidget" name="CurrencySettings">
  <layout class="QVBoxLayout" name="CurrencySettings_layout">
   <item>
    <layout class="QFormLayout" name="formLayout_currency_war">
     <item row="0" column="0">
      <widget class="QLabel" name="Currency_exit_plane_label">
       <property name="text">
        <string>在何位面完成投资策略选择后立即退出：</string>
