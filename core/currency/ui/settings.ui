    </widget>
   </item>
   <item>
    <widget class="QPushButton" name="Currency_deployment_settings_btn">
     <property name="text">
      <string>配置角色上阵优先级</string>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="Currency_settings_label">
     <property name="text">
      <string>TIPS:</string>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="Currency_settings_label">
     <property name="text">
      <string>金币和星徽大使叽米仅能在第二、三位面刷出；环保大使叽米仅能在第二位面刷出</string>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="Currency_settings_label">
     <property name="text">
      <string>检测到必选环境会直接选择，跳过刷新；若未刷出必选环境，则刷新</string>
     </property>
    </widget>
   </item>
  </layout>
 </widget>
